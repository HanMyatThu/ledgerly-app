# Rendered by the nginx image at start-up: ${API_URL} comes from the environment.
server {
  listen 80;
  root /usr/share/nginx/html;

  # Hashed build assets never change, so let browsers keep them.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # The API lives in its own container.
  location /api/ {
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    client_max_body_size 2m;
  }

  # Client-side routes such as /budgets fall back to the app.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
