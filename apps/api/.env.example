# Copy to .env and adjust as needed.

# Port the API listens on
PORT=4000

# Where transactions are kept: sqlite or memory
STORE=sqlite

# Path to the SQLite database file (defaults to apps/api/data/ledgerly.db)
# DATABASE_PATH=./data/ledgerly.db

# Log level: debug, info, warn, error or silent (silent turns off request logs)
LOG_LEVEL=info
