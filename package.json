{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "description": "Personal budget and expense tracker built as a React + Node.js monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @ledgerly/api",
    "dev:web": "npm run dev -w @ledgerly/web",
    "seed": "npm run seed -w @ledgerly/api --",
    "db:reset": "npm run db:reset -w @ledgerly/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
