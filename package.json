{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal budget and expense tracker built as a React + Node.js monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @ledgerly/api",
    "dev:web": "npm run dev -w @ledgerly/web",
    "seed": "npm run seed -w @ledgerly/api --",
    "db:reset": "npm run db:reset -w @ledgerly/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
